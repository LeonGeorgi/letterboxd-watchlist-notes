{
  "name": "letterboxd-watchlist-notes",
  "version": "1.3.0",
  "description": "Add private notes to films in a Letterboxd watchlist.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build",
    "check": "prettier --check . && eslint . --max-warnings 0 && vue-tsc --noEmit && vitest run && vite build",
    "dev": "vite build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "letterboxd",
    "watchlist"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "dependencies": {
    "vue": "^3.5.40"
  }
}
